<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0d0709">
<title>Drzewko rozwoju</title>
<style>
:root{
  --bg:#0d0709; --bgtop:#3d1019; --m:#f3c33c; --m2:#ffe08a; --a:#52e0f5; --ad:#2a6f7c;
  --ink:#e8f4f6; --muted:#7c9aa1; --red:#ff6b6b; --lock:#3a565d;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;color:var(--ink);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif}
body{
  background:
    repeating-linear-gradient(0deg,rgba(255,255,255,.015) 0 1px,transparent 1px 4px),
    radial-gradient(1200px 700px at 50% -10%,var(--bgtop) 0%,color-mix(in srgb,var(--bgtop) 45%,#0b0507) 45%,#0b0507 100%);
  background-attachment:fixed;
  overflow-x:hidden;
}
button{font:inherit;color:inherit;cursor:pointer}
.view{min-height:100dvh;display:none;flex-direction:column}
.view.on{display:flex}

/* ---------- menu przedmiotów ---------- */
.menuwrap{max-width:560px;width:100%;margin:0 auto;padding:calc(env(safe-area-inset-top) + 28px) 18px 28px;display:flex;flex-direction:column;gap:16px}
.brand{letter-spacing:.28em;text-transform:uppercase;font-weight:800;font-size:.8rem;color:var(--red)}
h1.big{margin:2px 0 6px;font-size:1.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--m);text-shadow:0 0 18px color-mix(in srgb,var(--m) 35%,transparent)}
.lead{color:var(--muted);margin:0 0 6px;font-size:.95rem}
.tile{
  position:relative;display:flex;align-items:center;gap:18px;width:100%;text-align:left;
  padding:20px 18px;border:1.5px solid var(--ad);background:linear-gradient(135deg,color-mix(in srgb,var(--a) 7%,transparent),rgba(0,0,0,.4));
  clip-path:polygon(0 0,calc(100% - 20px) 0,100% 20px,100% 100%,20px 100%,0 calc(100% - 20px));
}
.tile>svg.i{width:64px;height:64px;flex:0 0 auto;color:var(--a)}
.tile>svg.i.lockic{width:26px;height:26px;position:absolute;right:20px;top:50%;transform:translateY(-50%);color:var(--muted)}
.tile .nm{font-size:1.25rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
.tile .st{font-size:.85rem;color:var(--muted);margin-top:4px}
.tile.live{border-color:var(--m);background:linear-gradient(135deg,color-mix(in srgb,var(--m) 16%,transparent),rgba(8,4,6,.6));box-shadow:inset 0 0 40px color-mix(in srgb,var(--m) 14%,transparent)}
.tile.live>svg.i{color:var(--m2)}
.tile.live .nm{color:var(--m)}
.tile.live .st{color:var(--m2)}
.tile{transition:box-shadow .2s,background .2s}
.tile:not(.off):hover{background:linear-gradient(135deg,color-mix(in srgb,var(--m,var(--a)) 24%,transparent),rgba(8,4,6,.55));box-shadow:inset 0 0 44px color-mix(in srgb,var(--m,var(--a)) 28%,transparent),0 0 22px color-mix(in srgb,var(--m,var(--a)) 25%,transparent)}
nav#side button{transition:background .2s,box-shadow .2s}
nav#side button:hover{background:color-mix(in srgb,var(--sc,var(--a)) 16%,transparent);box-shadow:inset 0 0 22px color-mix(in srgb,var(--sc,var(--a)) 26%,transparent)}
.tile.off{cursor:default;opacity:.55;border-style:dashed}
.tile.off .nm{padding-right:34px}
.bar{height:6px;background:rgba(255,255,255,.1);margin-top:8px;border-radius:3px;overflow:hidden}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--m),var(--m2));width:0;transition:width .4s}
svg.i{fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* ---------- widok przedmiotu ---------- */
.top{display:flex;align-items:center;gap:12px;padding:calc(env(safe-area-inset-top) + 12px) 14px 10px;border-bottom:1px solid color-mix(in srgb,var(--a) 15%,transparent)}
.back{border:1px solid var(--ad);background:color-mix(in srgb,var(--a) 6%,transparent);color:var(--a);padding:8px 12px;font-size:.85rem;letter-spacing:.06em;text-transform:uppercase}
.top h2{margin:0;font-size:1.05rem;letter-spacing:.2em;text-transform:uppercase;color:var(--m)}
.top small{display:block;color:var(--muted);letter-spacing:.08em;font-size:.72rem;margin-top:2px}
.body{flex:1;display:flex;min-height:0;position:relative}
nav#side{flex:0 0 90px;display:flex;flex-direction:column;border-right:1px solid color-mix(in srgb,var(--a) 15%,transparent);background:rgba(0,0,0,.25);padding-top:10px}
nav#side button{background:none;border:0;border-left:3px solid transparent;color:var(--sc,var(--a));padding:12px 0 10px;display:flex;flex-direction:column;align-items:center;gap:3px;border-bottom:1px solid color-mix(in srgb,var(--a) 10%,transparent)}
nav#side button svg{width:30px;height:30px}
nav#side button b{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--sc,var(--ink))}
nav#side button span{font-size:.66rem;color:var(--muted)}
nav#side button.on{background:linear-gradient(90deg,color-mix(in srgb,var(--sc,var(--a)) 24%,transparent),color-mix(in srgb,var(--sc,var(--a)) 4%,transparent));border-left-color:var(--sc,var(--a))}
nav#side button.soon{color:var(--lock)}
nav#side button.soon b{color:var(--muted)}
#main{flex:1;display:flex;flex-direction:column;min-width:0}
#stage{flex:1;overflow-x:auto;overflow-y:visible;padding:6px 6px 120px}
#stage svg.tree{width:100%;margin:0 auto;height:auto;display:block}
.placeholder{align-self:center;text-align:center;color:var(--muted);padding:30px;line-height:1.5}
.placeholder svg{width:70px;height:70px;color:var(--lock);margin-bottom:8px}

/* węzły drzewka */
.tree .ln{stroke-width:1.3;fill:none}
.tree .ln.dim{stroke:color-mix(in srgb,var(--ad) 70%,#000)}
.tree .ln.cy{stroke:var(--a);opacity:.75}
.tree .ln.au{stroke:var(--m);filter:drop-shadow(0 0 3px color-mix(in srgb,var(--m) 80%,transparent))}
.tree .node{cursor:pointer;outline:none}
.tree .sh{stroke-width:2.4;transition:fill .2s,stroke .2s}
.tree .sh2{fill:none;stroke-width:1;opacity:.55}
.tree .ic{fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.tree .lb{font-size:9.6px;letter-spacing:.02em;stroke:#0b0507;stroke-width:4.5px;paint-order:stroke;stroke-linejoin:round}
.tree .node.locked .sh{stroke:color-mix(in srgb,var(--ad) 60%,#000);fill:color-mix(in srgb,var(--ad) 10%,#08080a)}
.tree .node.locked .sh2{stroke:color-mix(in srgb,var(--ad) 60%,#000)}
.tree .node.locked .ic{color:color-mix(in srgb,var(--ad) 80%,#000)}
.tree .node.locked .lb{fill:color-mix(in srgb,var(--ad) 45%,#8a979c)}
.tree .node.available .sh{stroke:var(--a);fill:color-mix(in srgb,var(--a) 14%,#0b0507);animation:glow 1.9s ease-in-out infinite}
.tree .node.available .sh2{stroke:var(--a)}
.tree .node.available .ic{color:color-mix(in srgb,var(--a) 35%,#fff)}
.tree .node.available .lb{fill:var(--ink)}
.tree .node.mastered .sh{stroke:var(--m);fill:color-mix(in srgb,var(--m) 18%,#0b0507);filter:drop-shadow(0 0 5px color-mix(in srgb,var(--m) 85%,transparent))}
.tree .node.mastered .sh2{stroke:var(--m2)}
.tree .node.mastered .ic{color:var(--m2)}
.tree .node.mastered .lb{fill:var(--m2);font-weight:600}
.tree .node:focus-visible .sh{stroke-width:3.5}
.tree .node:hover .sh,.tree .node:focus-visible .sh{fill:color-mix(in srgb,var(--m) 26%,#0b0507);filter:drop-shadow(0 0 9px color-mix(in srgb,var(--m) 75%,transparent))}
.tree .node.locked:hover .sh{fill:color-mix(in srgb,var(--ad) 28%,#08080a);filter:drop-shadow(0 0 6px color-mix(in srgb,var(--ad) 80%,transparent))}
.tree .node.available:hover .sh{fill:color-mix(in srgb,var(--a) 30%,#0b0507)}
.tree .root .lb{font-size:13px;font-weight:800;letter-spacing:.2em;fill:var(--m)}
@keyframes glow{50%{filter:drop-shadow(0 0 7px color-mix(in srgb,var(--a) 90%,transparent))}}
@media (prefers-reduced-motion:reduce){.tree .node.available .sh{animation:none}}


/* zablokowane: wyraźnie przygaszone */
.tree .node.locked{opacity:.5;filter:saturate(.3) brightness(.8);transition:opacity .2s}
.tree .node.locked:hover{opacity:.85}
.tree .ln.dim{opacity:.55}
/* animacja zdobycia */
.tree .bd{transform-box:fill-box;transform-origin:center}
.tree .node.pop .bd{animation:popspin .9s cubic-bezier(.45,0,.3,1) both}
@keyframes popspin{0%{transform:scale(1) rotate(0)}45%{transform:scale(1.55) rotate(180deg)}100%{transform:scale(1) rotate(360deg)}}
.tree .node.wv .bd{animation:wvpulse .6s ease-out both;animation-delay:var(--d,0ms)}
@keyframes wvpulse{0%{transform:scale(1)}40%{transform:scale(1.14);filter:drop-shadow(0 0 8px var(--m2))}100%{transform:scale(1)}}
.tree .cab.wv .ln{animation:cabwv .7s ease-out both;animation-delay:var(--d,0ms)}
@keyframes cabwv{0%{stroke-width:1.3}35%{stroke-width:3;stroke:#fff;opacity:1}100%{stroke-width:1.3}}
#fx{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0;
  -webkit-mask-image:linear-gradient(180deg,transparent 35%,#000 50%,transparent 65%);mask-image:linear-gradient(180deg,transparent 35%,#000 50%,transparent 65%);
  -webkit-mask-size:100% 300%;mask-size:100% 300%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
#fx.go{animation:fxsweep 1.8s ease-in-out both}
@keyframes fxsweep{0%{opacity:0;-webkit-mask-position:0 100%;mask-position:0 100%}12%{opacity:.5}88%{opacity:.5}100%{opacity:0;-webkit-mask-position:0 0;mask-position:0 0}}
.view{position:relative;z-index:1}
@media (prefers-reduced-motion:reduce){#fx{display:none}.tree .node.pop .bd{animation:none}}

/* pojawianie się drzewka po wejściu w dziedzinę */
.tree .node.in{transform-box:fill-box;transform-origin:center;animation:nodein .5s cubic-bezier(.2,.9,.3,1.2) both;animation-delay:var(--id,0ms)}
@keyframes nodein{from{opacity:0;transform:scale(.55)}}
.tree .cab.in{animation:cabin .45s ease-out both;animation-delay:var(--id,0ms)}
@keyframes cabin{from{opacity:0}}


/* zakładki ścieżek w dziedzinie */
#pathbar{flex-wrap:wrap}
#pathbar .pb-tabs{flex:0 0 100%;display:flex;gap:6px;overflow-x:auto;padding-top:2px}
#pathbar .pb-tabs button{flex:0 0 auto;border:1px solid var(--m);background:rgba(0,0,0,.35);color:var(--m2);padding:6px 10px;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700}
#pathbar .pb-tabs button:hover{background:color-mix(in srgb,var(--m) 25%,transparent)}
#pathbar .pb-tabs button.on{background:var(--m);color:#0b0507}
/* dziennik partii */
.gp{margin:4px 4px 14px;padding:12px 14px;border:1.5px solid var(--ad);background:linear-gradient(135deg,color-mix(in srgb,var(--m) 8%,transparent),rgba(0,0,0,.4));clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px))}
.gp-h{font-size:.7rem;letter-spacing:.28em;text-transform:uppercase;color:var(--m2);font-weight:800}
.gp summary{display:flex;align-items:center;gap:10px;cursor:pointer;list-style:none}
.gp summary::-webkit-details-marker{display:none}
.gp summary::after{content:"\25BE";margin-left:auto;color:var(--m2);transition:transform .2s}
.gp[open] summary::after{transform:rotate(180deg)}
.gp summary em{font-style:normal;font-size:.74rem;color:var(--muted)}
.gp[open] summary{margin-bottom:8px}
.gp-row{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:.85rem}
.gp-row span{flex:1;min-width:0}
.gp-row b{min-width:2ch;text-align:center;font-size:1.05rem;color:#fff}
.gp-row button,.gc-act button{border:1px solid var(--ad);background:rgba(0,0,0,.4);color:var(--m2);width:32px;height:30px;font-size:1.1rem;line-height:1}
.gp-row button:hover:not(:disabled){background:color-mix(in srgb,var(--m) 25%,transparent);box-shadow:0 0 10px color-mix(in srgb,var(--m) 40%,transparent)}
.gp button:disabled,.gc-act button:disabled{opacity:.3;cursor:default}
.gp-req{margin-top:8px;font-size:.74rem;color:var(--muted);line-height:1.5}
.gp-req b{color:var(--ink);letter-spacing:.06em}
.gp-req i{font-style:normal;font-weight:800}.gp-req i.ok{color:#5be08b}.gp-req i.no{color:var(--red)}
/* kafelki gier logicznych */
.gtiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;padding:4px}
.gcard{border:1.5px solid color-mix(in srgb,var(--gc) 55%,#000);padding:14px;display:flex;flex-direction:column;gap:8px;background:linear-gradient(135deg,color-mix(in srgb,var(--gc) 9%,transparent),rgba(0,0,0,.45));
  clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));transition:background .2s,box-shadow .2s}
.gcard:hover{background:linear-gradient(135deg,color-mix(in srgb,var(--gc) 22%,transparent),rgba(8,4,6,.5));box-shadow:inset 0 0 36px color-mix(in srgb,var(--gc) 26%,transparent)}
.gcard.done{border-color:var(--gc);box-shadow:inset 0 0 30px color-mix(in srgb,var(--gc) 22%,transparent)}
.gc-top{display:flex;align-items:center;gap:12px}
.gc-top svg{width:44px;height:44px;flex:0 0 auto;color:var(--gc)}
.gc-top h3{margin:0;font-size:1rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gc)}
.gc-cur{font-size:.8rem;color:var(--ink);margin-top:2px}
.gc-desc{margin:0;font-size:.78rem;color:var(--muted);line-height:1.45}
.gc-bar{height:6px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden}
.gc-bar i{display:block;height:100%;background:var(--gc);width:0;transition:width .4s}
.gc-nxt{font-size:.72rem;color:color-mix(in srgb,var(--gc) 70%,#fff)}
.gc-act{display:flex;gap:8px;margin-top:2px}
.gc-act .gc-p{flex:1;width:auto;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;font-weight:700;border-color:var(--gc);color:var(--gc)}
.gc-act .gc-p:hover:not(:disabled){background:color-mix(in srgb,var(--gc) 22%,transparent)}
.gcard.in{animation:nodein .5s cubic-bezier(.2,.9,.3,1.2) both;animation-delay:var(--id,0ms)}

.demo{margin-top:6px;padding-top:14px;border-top:1px solid color-mix(in srgb,var(--a) 14%,transparent);display:flex;flex-direction:column;gap:8px;font-size:.78rem;color:var(--muted);line-height:1.45}
.demo button{align-self:flex-start;border:1px solid var(--ad);background:rgba(0,0,0,.35);color:var(--a);padding:8px 12px;font-size:.74rem;letter-spacing:.06em;text-transform:uppercase}
.demo button.sure{border-color:var(--red);color:var(--red)}
.demo button:hover{background:color-mix(in srgb,var(--a) 14%,transparent)}

/* stopka */
.foot{position:sticky;bottom:0;display:flex;align-items:center;gap:12px;padding:10px 14px calc(env(safe-area-inset-bottom) + 10px);background:linear-gradient(0deg,#0b0507 60%,rgba(11,5,7,.0));border-top:1px solid color-mix(in srgb,var(--a) 12%,transparent)}
.foot .cnt{flex:1;font-size:.85rem;color:var(--a);letter-spacing:.06em;text-transform:uppercase}
.foot .cnt b{color:var(--m);font-size:1.15rem}
.foot .hint{color:var(--muted);font-size:.72rem;text-transform:none;letter-spacing:0;margin-top:2px}
.rst{border:1px solid #6b2a2f;background:rgba(255,107,107,.07);color:var(--red);padding:8px 12px;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase}
.rst.sure{background:var(--red);color:#1a0508}

/* panel szczegółów */
#shade{position:fixed;inset:0;background:rgba(0,0,0,.55);opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}
#shade.on{opacity:1;pointer-events:auto}
#sheet{
  position:fixed;left:50%;bottom:0;transform:translate(-50%,105%);width:min(560px,100%);z-index:21;transition:transform .25s;
  background:linear-gradient(180deg,#14090d,#0b0507);border:1.5px solid var(--ad);border-bottom:0;
  padding:18px 18px calc(env(safe-area-inset-bottom) + 18px);
  clip-path:polygon(0 18px,18px 0,calc(100% - 18px) 0,100% 18px,100% 100%,0 100%);
}
#sheet.on{transform:translate(-50%,0)}
#sheet .hd{display:flex;gap:14px;align-items:center}
#sheet .hd svg{width:54px;height:54px;flex:0 0 auto;color:var(--a)}
#sheet h3{margin:0;font-size:1.12rem;letter-spacing:.05em}
.chip{display:inline-block;margin-top:4px;padding:2px 10px;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;border:1px solid currentColor}
.chip.mastered{color:var(--m)}.chip.available{color:var(--a)}.chip.locked{color:var(--muted)}
#sheet p{margin:12px 0 0;line-height:1.5;font-size:.95rem}
#sheet .goal{border-left:3px solid var(--m);padding:6px 10px;background:color-mix(in srgb,var(--m) 8%,transparent)}
#sheet .goal b{color:var(--m);display:block;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase}
#sheet .need{color:var(--red)}
#sheet{max-height:90dvh;overflow-y:auto}
#sheet .pz{margin-top:14px;border:1px dashed var(--ad);padding:12px;background:color-mix(in srgb,var(--a) 4%,transparent)}
#sheet .pz h4{margin:0 0 4px;color:var(--a);font-size:.8rem;letter-spacing:.14em;text-transform:uppercase}
#sheet .pz p{margin:8px 0 0}
#sheet .pz .lst{font-size:.85rem;color:var(--muted);margin-top:4px}
#sheet .pz .lst b{color:var(--ink)}
#sheet .pz ol{margin:10px 0 0;padding-left:22px}
#sheet .pz li{margin-bottom:6px;line-height:1.4;font-size:.93rem}
#sheet .pz .q{font-weight:700;color:var(--m2)}
.pzbtn{margin-top:10px;width:100%;padding:11px;border:1px solid var(--ad);background:color-mix(in srgb,var(--a) 8%,transparent);color:var(--a);text-transform:uppercase;letter-spacing:.08em;font-size:.8rem}
#pzSol{margin-top:8px;border-left:3px solid var(--a);padding:2px 10px;background:color-mix(in srgb,var(--a) 7%,transparent)}
.acts{display:flex;gap:10px;margin-top:16px}
.acts button{flex:1;padding:13px;border:1px solid var(--ad);background:color-mix(in srgb,var(--a) 6%,transparent);color:var(--ink);text-transform:uppercase;letter-spacing:.08em;font-size:.85rem}
.acts button.main{background:var(--m);border-color:var(--m);color:#1d1403;font-weight:800}
.acts button.undo{border-color:#6b2a2f;color:var(--red);background:rgba(255,107,107,.07)}
#toast{position:fixed;left:50%;transform:translateX(-50%);top:calc(env(safe-area-inset-top) + 152px);background:#000c;border:1px solid var(--ad);color:var(--ink);padding:9px 16px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .2s;z-index:40;max-width:90vw;text-align:center}
#toast.show{opacity:1}

/* motywy kolorystyczne dziedzin */
body[data-th="push"]{--m:#ff5a4d;--m2:#ffb3ab;--a:#ffc14d;--ad:#8a3f38;--bgtop:#40120e}
body[data-th="pull"]{--m:#4da3ff;--m2:#b3d6ff;--a:#7df0ff;--ad:#31669a;--bgtop:#0e2140}
body[data-th="legs"]{--m:#3ddc84;--m2:#a9f0c8;--a:#c6ff5c;--ad:#2f7d52;--bgtop:#0e2f1c}
body[data-th="core"]{--m:#ffc233;--m2:#ffe29a;--a:#ff8a3d;--ad:#85601c;--bgtop:#3a2a0a}
body[data-th="strategy"]{--m:#b48cff;--m2:#dcc9ff;--a:#ffd76b;--ad:#5f4a97;--bgtop:#24143f}
body[data-th="programming"]{--m:#4c97ff;--m2:#b7d3ff;--a:#ffab19;--ad:#336aab;--bgtop:#0d2142}
body[data-th="crime"]{--m:#2ec4b6;--m2:#a6efe8;--a:#ffd166;--ad:#216e69;--bgtop:#0a2926}
/* pasek ścieżki rozwoju */
#pathbar{position:sticky;top:0;z-index:6;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px 11px 16px;
  background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--m) 28%,#0b0507) 0 9px,color-mix(in srgb,var(--m) 13%,#0b0507) 9px 18px);
  border-bottom:2px solid var(--m);box-shadow:0 6px 20px color-mix(in srgb,var(--m) 28%,transparent)}
#pathbar .pb-k{display:block;font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--m2)}
#pathbar .pb-k::before{content:"\00BB\00BB  ";letter-spacing:.1em}
#pathbar .pb-n{display:block;margin-top:2px;font-size:1.2rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#fff;text-shadow:0 0 14px var(--m)}
#pathbar .pb-c{flex:0 0 auto;font-size:.85rem;color:var(--m2);letter-spacing:.08em;text-align:right}
#pathbar .pb-c b{font-size:1.25rem;color:#fff}
.tree .colsub{font-size:7.5px;font-weight:700;letter-spacing:.3em;fill:var(--ad);opacity:.95}
